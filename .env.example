# ORION Backend Environment Configuration Template
PROJECT_NAME="ORION - KSM AIoT API"
API_V1_STR="/orion/api/v1"
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL / TimescaleDB)
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
DATABASE_URL=

# Security & JWT Tokens (Generate with: openssl rand -hex 32)
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:5173"]
